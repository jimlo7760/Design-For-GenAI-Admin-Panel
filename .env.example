# The same Supabase project as the Mod Squad app (Project Settings > API).
# Both values are public by design: the database itself decides what each signed-in person may do.
# There is no service-role key anywhere in this app, and it should stay that way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: IANA time zone for the "rush hour" heatmap and the day-by-day charts (default America/New_York).
# ADMIN_TIME_ZONE=America/New_York
